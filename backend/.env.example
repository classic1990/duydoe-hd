# Firebase Admin Configuration - Development
# คัดลอกค่าจาก service-account-key.json ที่ได้จาก Firebase Console
# หรือดูคำแนะนำใน README.md

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Server Configuration
PORT=3000
NODE_ENV=development

# AppCheck Configuration (optional)
APP_CHECK_DEBUG_TOKEN=YOUR_DEBUG_TOKEN

# Gemini API Key (ถ้าใช้ AI features)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
